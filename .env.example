# Copy to .env and edit. Compose auto-loads .env from the project root.
#
# ----- access control -----
# Empty (default) → no auth on the API. Set this before exposing on a LAN.
NOETICA_API_KEY=

# Comma-separated browser origins allowed to call /v1/*. Use "*" to allow all
# (only valid when NOETICA_API_KEY is empty, since CORS doesn't allow wildcards
# with credentials).
NOETICA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- logging -----
# Structured JSON logs to stdout. Set to false for human-readable dev logs.
NOETICA_JSON_LOGS=true
NOETICA_LOG_LEVEL=INFO

# ----- runtime -----
# Inside docker-compose gpu/full this is http://ollama:11434.
# On the cpu profile, bin/up sets http://host.docker.internal:11434.
OLLAMA_URL=http://ollama:11434
OLLAMA_TIMEOUT_SECONDS=180

# Models — bump for a GPU workstation.
MODEL_TEXT=qwen2.5:7b-instruct
MODEL_VISION=qwen2.5vl:7b
MODEL_EMBED=nomic-embed-text

# ----- Open WebUI (chat) -----
# Disable the login screen for first run; flip to True once you set up admin
# and especially before any LAN exposure (see SECURITY.md).
WEBUI_AUTH=False
