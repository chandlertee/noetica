# GPU training image for the `train` compose profile (the [train] extra).
# Heavy by design — torch + CUDA + unsloth. Kept entirely separate from the
# lightweight serve image (Dockerfile) so chat + API never pull this.
#
# Build/run via compose:
#   docker compose --profile train run --rm noetica-train \
#     python -m noetica.train.finetune --config noetica/train/configs/qwen2.5-7b.yaml
#
# Requires the NVIDIA Container Toolkit on the host (Linux) or Docker Desktop +
# WSL2 with a recent NVIDIA driver (Windows). See noetica/train/README.md.

# Pin CUDA 12.4: PyPI torch wheels bundle a CUDA 12.x runtime and Unsloth is
# tested against 12.x. Don't let Dependabot bump this to a CUDA the torch
# wheels don't match (the dependabot config ignores cuda minor/major bumps).
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive

# build-essential + cmake + curl: Unsloth's save_pretrained_gguf builds llama.cpp.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        python3 python3-pip git build-essential cmake curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Install the package with the [train] extra. Copy only metadata first for layer
# caching; the source is bind-mounted at runtime by the compose service.
COPY pyproject.toml README.md ./
COPY noetica ./noetica
RUN pip3 install --no-cache-dir ".[train]"

CMD ["python3", "-m", "noetica.train.finetune", "--help"]
